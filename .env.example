# Bot
TELEGRAM_BOT_TOKEN=        # Token del bot — BotFather de Telegram

# Mercado Pago (fase 2 — no implementar aún)
# MP_ACCESS_TOKEN=

# Configuración
REMINDER_DAYS=3            # Días antes de enviar recordatorio automático
MAX_LOGO_SIZE_MB=2         # Tamaño máximo de logo en MB
PDF_DIR=pdfs               # Carpeta donde se guardan los PDFs de presupuesto generados

# Solo desarrollo local en Windows con MSYS2 (no aplica en Linux/Mac ni en CI):
# WeasyPrint busca las DLLs de GTK/Pango en C:\msys64\mingw64\bin por defecto.
# Si instalaste Pango con "MSYS2 UCRT64" en vez del shell clásico, las DLLs
# quedan en ucrt64\bin y hay que indicárselo explícitamente:
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin
